<?xml version="1.0" encoding="UTF-8"?>
<!--
  執行前必讀（詳見專案 README「壓測」章節）：
  - RabbitMQ 要先啟動：docker compose up -d
  - JSR223 PreProcessor 用 Groovy 算 HMAC 簽章。本機預設 Java 太新，JMeter 5.6.3 內建的
    Groovy/ASM 編譯不了，會噴 "Unsupported class file major version 70"。
    解法：scoop install corretto21-jdk，啟動 jmeter 前把它的 bin 目錄排到 PATH 最前面：
      PATH="$(scoop prefix corretto21-jdk)/bin:$PATH" jmeter -n -t loadtest/call-webhook.jmx ...
    注意 JAVA_HOME 對這個 jmeter.bat 沒用，它找 java.exe 只看 PATH。
  - 密鑰寫死在腳本裡（dev-shared-secret），對應 application.yml 的 settlement.webhook.secret 預設值，
    正式環境或改過密鑰時要記得同步改這裡。
  - externalReferenceId 是隨機產生的假資料，不對應真實轉帳，TransferResultListener 會找不到、
    重試耗盡後進 transfer.result.inbox.dlq，測完記得清空這個 queue。
  - 參數（-Jxxx=yyy）：threads、ramp、loops（每個執行緒跑幾次，不是跑幾秒）、port、host
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Ledger - call webhook">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Call Webhook">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,5)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${__P(loops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request">
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8111)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/webhooks/settlement</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${webhookBody}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Signature and Body Creator">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

def refId = &quot;LOADTEST-&quot; + UUID.randomUUID()
def eventId = UUID.randomUUID().toString()
def result = &quot;CONFIRMED&quot;

def body = &quot;{\&quot;externalReferenceId\&quot;:\&quot;${refId}\&quot;,\&quot;externalEventId\&quot;:\&quot;${eventId}\&quot;,\&quot;result\&quot;:\&quot;${result}\&quot;}&quot;

def secret = vars.get(&quot;secret&quot;) ?: &quot;dev-shared-secret&quot;
def mac = Mac.getInstance(&quot;HmacSHA256&quot;)
mac.init(new SecretKeySpec(secret.getBytes(&quot;UTF-8&quot;), &quot;HmacSHA256&quot;))
def digest = mac.doFinal(body.getBytes(&quot;UTF-8&quot;))
def signature = digest.collect { String.format(&quot;%02x&quot;, it) }.join(&quot;&quot;)

vars.put(&quot;webhookBody&quot;, body)
vars.put(&quot;webhookSignature&quot;, signature)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Signature</stringProp>
                <stringProp name="Header.value">${webhookSignature}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Assertion">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
